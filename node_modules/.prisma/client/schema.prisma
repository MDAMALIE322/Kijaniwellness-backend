generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String              @id @default(cuid())
  email          String              @unique
  passwordHash   String?
  createdAt      DateTime            @default(now())
  deletedAt      DateTime?
  profile        UserProfile?
  meals          MealLog[]
  workouts       WorkoutSession[]
  fastingLogs    FastingLog[]
  herbalLogs     HerbalLog[]
  consents       PrivacyConsent[]
  exportRequests DataExportRequest[]

  @@index([email])
}

model UserProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id])
  displayName      String?
  heightCm         Float?
  weightKg         Float?
  ageYears         Int?
  biologicalSex    String?
  goalType         String   @default("wellness")
  activityLevel    String   @default("moderate")
  targetWeightKg   Float?
  allergies        String[]
  dietaryFlags     String[]
  africanFoodsMode Boolean  @default(true)
  updatedAt        DateTime @updatedAt
}

model MealLog {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  loggedAt     DateTime   @default(now())
  mealType     String
  totalCal     Float?
  totalProtein Float?
  totalCarbs   Float?
  totalFat     Float?
  notes        String?
  source       String     @default("manual")
  items        MealItem[]

  @@index([userId, loggedAt])
}

model MealItem {
  id           String  @id @default(cuid())
  mealLogId    String
  mealLog      MealLog @relation(fields: [mealLogId], references: [id])
  foodName     String
  portionGrams Float?
  calories     Float?
  protein      Float?
  carbs        Float?
  fat          Float?
  confidence   Float?
}

model WorkoutSession {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  startedAt   DateTime @default(now())
  durationMin Int?
  notes       String?
  exercises   Json?

  @@index([userId, startedAt])
}

model FastingLog {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  fastType        String
  startedAt       DateTime
  endedAt         DateTime?
  targetHours     Float?
  safetyConfirmed Boolean   @default(false)
  notes           String?

  @@index([userId])
}

model HerbalLog {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  herbName String
  form     String?
  notes    String?
  loggedAt DateTime @default(now())

  @@index([userId])
}

model PrivacyConsent {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  consentType String
  accepted    Boolean
  acceptedAt  DateTime
  version     String   @default("1.0")

  @@index([userId])
}

model DataExportRequest {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  requestedAt DateTime @default(now())
  status      String   @default("pending")
  downloadUrl String?

  @@index([userId])
}
